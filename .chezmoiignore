# Manage .bashrc only on Android/Termux and Linux for now. Other hosts keep
# their host-specific .bashrc until branches are added to dot_bashrc.tmpl.
{{ if and (ne .chezmoi.os "android") (ne .chezmoi.os "linux") }}
.bashrc
{{ end }}

# Manage .zshrc only where zsh is installed.
{{ if not (lookPath "zsh") }}
.zshrc
{{ end }}

# SwiftBar is macOS-only
{{ if ne .chezmoi.os "darwin" }}
.config/swiftbar/**
{{ end }}

# Termux:Widget shortcuts only exist on Android/Termux, where the desktop
# launcher reads ~/.shortcuts. Ignoring the directory keeps it unmanaged on
# every other host.
{{ if ne .chezmoi.os "android" }}
.shortcuts
.shortcuts/**
{{ end }}

# Ignore the age private key backup (if any)
key.txt.age

# .sops.yaml only configures sops inside the source checkout
.sops.yaml

# Ignore documentation
README.md

# Ignore internal scripts, secret source files, and the repository-only test
# suite for the Termux shortcut. Patterns are target paths, and ignoring the
# directory covers everything beneath it.
scripts/
secrets/
.config/termux/
