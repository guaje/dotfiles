# Manage .bashrc only on Android/Termux and Linux for now. Other hosts keep
# their host-specific .bashrc until branches are added to dot_bashrc.tmpl.
{{ if and (ne .chezmoi.os "android") (ne .chezmoi.os "linux") }}
.bashrc
{{ end }}

# Manage .zshrc only where zsh is installed.
{{ if not (lookPath "zsh") }}
.zshrc
{{ end }}

# macOS-only. Ignoring the directory keeps it unmanaged on
# every other host.
{{ if ne .chezmoi.os "darwin" }}
.config/swiftbar/**
{{ end }}

# Android/Termux-only. Ignoring the directory keeps it unmanaged on
# every other host.
{{ if ne .chezmoi.os "android" }}
.shortcuts
.shortcuts/**
.termux
.termux/**
{{ end }}

# Ignore the age private key backup (if any)
key.txt.age

# .sops.yaml only configures sops inside the source checkout
.sops.yaml

# Ignore documentation
README.md

# Ignore internal scripts, secret source files, and the repository-only test suite
# for the Termux shortcut, which stays out of ~/.termux on every host including
# Android. Patterns are target paths.
scripts/
secrets/
.termux/tests
.termux/tests/**
