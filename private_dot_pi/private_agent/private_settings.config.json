{
  "defaultModel": "gpt-5.6-terra",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "reallms-dev/GLM-5.2",
    "kelley/Kimi-K2.6",
    "openai-codex/gpt-5.6-luna",
    "reallms-dev/Ornith-1.0-397B-FP8",
    "reallms-dev/Laguna-S-2.1-FP8",
    "reallms/gemma-4-31B-it",
    "reallms/Qwen3-Coder-Next"
  ],
  "extensions": [
    "-extensions/google-search.ts",
    "extensions/00-hud/index.ts",
    "extensions/01-permissions/index.ts",
    "extensions/02-handoff/index.ts",
    "extensions/03-stats/index.ts",
    "extensions/04-subagents/index.ts",
    "extensions/05-browse/index.ts",
    "extensions/06-health/index.ts",
    "extensions/07-native-notify.ts",
    "extensions/08-settings/index.ts"
  ],
  "imageGenerationProviders": {
    "reallms-dev": {
      "models": [
        {
          "id": "z-image-turbo",
          "name": "z-image-turbo"
        }
      ]
    }
  },
  "managingStyle": "Empowerment",
  "empowermentDisposableRoots": [
    "@user-temp"
  ],
  "permissionsSessionApprovalMaxRules": 100,
  "subagentRosterCap": 10,
  "subagentRosterScope": "user",
  "subagentMaxParallelTasks": 8,
  "subagentMaxConcurrency": 4,
  "modelHealthCacheTtlMs": 900000,
  "modelHealthProbeConcurrency": 3,
  "handoffRemoteRoot": "~/.local/state/pi/remote-sessions",
  "handoffShortcut": "ctrl+alt+s",
  "theme": "catppuccin-mocha"
}
