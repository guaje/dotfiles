{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultModel": "qwen3.8-flash-next",
  "defaultProvider": "model-testing",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6.1-terra",
    "openai-codex/gpt-5.6-sol",
    "reallms-dev/glm-5.3-flash",
    "model-testing/qwen3.8-flash-next",
    "openai-codex/gpt-6-luna",
    "model-testing/qwen3.8-27b",
    "reallms/qwen3.8-27b",
    "kelley/Kimi-K2.6",
    "model-testing/muse-glimmer"
  ],
  "extensions": [
    "extensions/00-hud/index.ts",
    "extensions/01-permissions/index.ts",
    "extensions/02-handoff/index.ts",
    "extensions/03-stats/index.ts",
    "extensions/04-subagents/index.ts",
    "extensions/05-browse/index.ts",
    "extensions/06-health/index.ts",
    "extensions/07-native-notify.ts",
    "extensions/08-settings/index.ts",
    "extensions/09-catalog/index.ts"
  ],
  "browse": {
    "fallbackProviders": [
      "tavily"
    ],
    "limits": {
      "maxCalls": 8,
      "maxFetchChars": 30000,
      "maxResponseBytes": 1000000,
      "maxResults": 8,
      "pollIntervalMs": 1000,
      "pollTimeoutMs": 120000,
      "retries": 1,
      "timeoutMs": 30000
    },
    "providers": {
      "linkup": {
        "baseUrl": "https://api.linkup.so"
      },
      "tavily": {
        "baseUrl": "https://api.tavily.com"
      }
    }
  },
  "catalog": {
    "artificialAnalysis": {
      "requestDelayMs": 250
    },
    "benchlm": {
      "requestDelayMs": 250
    },
    "refreshTtlMs": 14400000,
    "requestTimeoutMs": 10000
  },
  "handoff": {
    "hotkey": "ctrl+alt+s",
    "remoteRoot": "~/.local/state/pi/remote-sessions"
  },
  "health": {
    "cacheTtlMs": 300000,
    "probeConcurrency": 8
  },
  "imageGenerationProviders": {
    "reallms-dev": {
      "models": [
        {
          "id": "z-image-turbo",
          "name": "z-image-turbo"
        }
      ]
    }
  },
  "permissions": {
    "empowermentDisposableRoots": [
      "@user-temp"
    ],
    "managementStyleBackwardHotkey": "shift+ctrl+;",
    "managementStyleForwardHotkey": "ctrl+;",
    "managingStyle": "Empowerment",
    "sessionApprovalMaxRules": 100
  },
  "quietStartup": "header",
  "subagents": {
    "autoModelSelection": {
      "benchmarkSnapshotMaxAgeMs": 2592000000
    },
    "driftAlarmMinPoints": 12,
    "driftWarmupRows": 20,
    "healthProbeBudgetMs": 10000,
    "maxConcurrency": 4,
    "maxParallelTasks": 8,
    "maxProbeLatencyMs": 5000,
    "measuredSpeedMinimumRuns": 10,
    "outcomeInfluenceFullAt": 60,
    "outcomeWindow": 100,
    "researchMinimumContextWindow": 131072,
    "rosterCap": 10,
    "rosterScope": "user"
  },
  "theme": "catppuccin-mocha"
}
