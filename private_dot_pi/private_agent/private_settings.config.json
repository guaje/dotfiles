{
  "defaultModel": "gpt-5.6-terra",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "reallms/glm-5.2",
    "kelley/Kimi-K2.6",
    "openai-codex/gpt-5.6-luna",
    "reallms-dev/DeepSeek-V4-Flash-API",
    "reallms-dev/Laguna-S-2.1-FP8",
    "reallms/gemma-4-31B-it",
    "reallms/Qwen3-Coder-Next"
  ],
  "extensions": [
    "extensions/00-hud/index.ts",
    "extensions/01-permissions/index.ts",
    "extensions/02-handoff/index.ts",
    "extensions/03-stats/index.ts",
    "extensions/04-subagents/index.ts",
    "extensions/05-browse/index.ts",
    "extensions/06-health/index.ts",
    "extensions/07-native-notify.ts",
    "extensions/08-settings/index.ts"
  ],
  "browse": {
    "providers": {
      "linkup": {
        "baseUrl": "https://api.linkup.so"
      },
      "tavily": {
        "baseUrl": "https://api.tavily.com"
      }
    },
    "fallbackProviders": [
      "tavily"
    ],
    "limits": {
      "maxResults": 8,
      "maxResponseBytes": 1000000,
      "maxFetchChars": 30000,
      "maxCalls": 8,
      "timeoutMs": 30000,
      "retries": 1,
      "pollIntervalMs": 1000,
      "pollTimeoutMs": 120000
    }
  },
  "handoff": {
    "remoteRoot": "~/.local/state/pi/remote-sessions",
    "hotkey": "ctrl+alt+s"
  },
  "health": {
    "cacheTtlMs": 900000,
    "probeConcurrency": 3
  },
  "imageGenerationProviders": {
    "reallms-dev": {
      "models": [
        {
          "id": "z-image-turbo",
          "name": "z-image-turbo"
        }
      ]
    }
  },
  "permissions": {
    "managingStyle": "Empowerment",
    "empowermentDisposableRoots": [
      "@user-temp"
    ],
    "sessionApprovalMaxRules": 100,
    "managementStyleForwardHotkey": "ctrl+;",
    "managementStyleBackwardHotkey": "shift+ctrl+;"
  },
  "subagents": {
    "rosterCap": 10,
    "rosterScope": "user",
    "maxParallelTasks": 8,
    "maxConcurrency": 4
  },
  "theme": "catppuccin-mocha"
}
